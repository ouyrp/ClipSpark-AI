APP_ENV=development
DATABASE_URL=sqlite:///./clipspark.db
REDIS_URL=redis://localhost:6379/0

# Use a standard Bailian/DashScope API key for this backend.
# Coding Plan keys that start with sk-sp- use https://coding.dashscope.aliyuncs.com/v1
# and are documented for AI coding tools, not this product backend.
DASHSCOPE_API_KEY=replace-with-your-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_VISION_MODEL=qwen-vl-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_ASR_MODEL=paraformer-v2
ASR_PUBLIC_BASE_URL=

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=../../storage
FRONTEND_ORIGIN=http://localhost:3000
