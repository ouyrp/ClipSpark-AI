APP_ENV=development
DATABASE_URL=sqlite:///./clipspark.db
REDIS_URL=redis://localhost:6379/0

AI_PROVIDER=gemini

# Recommended free/trial option for video and visual understanding.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
GEMINI_VISION_MODEL=gemini-2.5-flash

# Free routing fallback. Requires an OpenRouter API key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEXT_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free

# Local no-cloud-cost fallback. Requires Ollama and installed models.
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEXT_MODEL=qwen2.5:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Use a standard Bailian/DashScope API key for this backend.
# Coding Plan keys that start with sk-sp- use https://coding.dashscope.aliyuncs.com/v1
# and are documented for AI coding tools, not this product backend.
DASHSCOPE_API_KEY=replace-with-your-key
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_TEXT_MODEL=qwen-plus
BAILIAN_VISION_MODEL=qwen-vl-plus
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_ASR_MODEL=paraformer-v2
ASR_PUBLIC_BASE_URL=

STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=../../storage
FRONTEND_ORIGIN=http://localhost:3000
